<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E1E1E"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tvDialogMovieTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Film Adı"
        android:textColor="#FFD700"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:gravity="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bu filme kaç puan verirsin?"
        android:textColor="#888888"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <RatingBar
        android:id="@+id/dialogRatingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:stepSize="1.0"
        android:layout_marginBottom="20dp"
        android:theme="@style/Widget.AppCompat.RatingBar" />

    <EditText
        android:id="@+id/etDialogComment"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:hint="Film hakkındaki düşüncelerin..."
        android:textColorHint="#555555"
        android:textColor="#FFFFFF"
        android:background="#121212"
        android:gravity="top|start"
        android:padding="12dp"
        android:inputType="textMultiLine"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnDialogCancel"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="İptal"
            android:textColor="#FFFFFF"
            android:backgroundTint="#444444"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnDialogSave"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Tamamla"
            android:textColor="#121212"
            android:textStyle="bold"
            android:backgroundTint="#2ECC71"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>