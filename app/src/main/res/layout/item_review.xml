<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp"
    android:backgroundTint="#1E1E1E"> <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvReviewMovieTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Film Başlığı"
        android:textColor="#FFD700"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <RatingBar
        android:id="@+id/reviewRatingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="?android:attr/ratingBarStyleSmall"
        android:numStars="5"
        android:stepSize="1.0"
        android:isIndicator="true"
        android:theme="@style/Widget.AppCompat.RatingBar"
        android:layout_marginBottom="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333333"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvReviewUserComment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kullanıcının film hakkındaki harika yorumu burada yer alacak."
        android:textColor="#DDDDDD"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp" />

</LinearLayout>
</androidx.cardview.widget.CardView>